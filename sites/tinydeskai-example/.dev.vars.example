# Copy to ~/.config/shipwords/<site>.dev.vars outside the repo, then run pnpm setup:worktree to link it in. Never commit real values.
APP_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-32-random-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Only when site.config.ts uses PayPal (this site uses Stripe, leave empty).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
GUEST_COOKIE_SECRET=replace-with-32-random-bytes
YIR_API_KEY=
# Test flows for free: 1 = outputs replaced with the reference clips and compose takes the first segment; fail = every segment fails (to test refunds).
# Only active when APP_URL is local or every payment key is in test mode.
UPSTREAM_MOCK=1
